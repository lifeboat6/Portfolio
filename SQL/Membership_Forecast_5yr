with 
add_term_step1 as (
select
a.pcp_region
, right(a.yearmonth, 2) as Month
, sum(a.adds) as adds
, sum(a.conv_in) as conv_in
, sum(a.terms) as terms
, sum(a.conv_out) as conv_out
, sum(a.total_net) as total_net
, sum(a.total_membership) as total_membership
, sum(a.plan_adds_conv_in) as plan_adds_conv_in
, sum(a.plan_terms_conv_out) as plan_terms_conv_out
from #assumptions_base_addsterms a
	inner join #plan_over_50 b on
		b.pcp_region = a.pcp_region
		and b.pcp_market = a.pcp_market
		and b.pcp_type = a.pcp_type
		and b.plan_code = a.plan_code
	left join #new_plans d on  
		d.pcp_region = a.pcp_region
		and d.pcp_market = a.pcp_market
		and d.pcp_type = a.pcp_type
		and d.plan_code = a.plan_code
where d.pcp_region is null 
--and b.pcp_region is not null
group by
a.pcp_region
, right(a.yearmonth, 2)
)
, add_term_step2 as (
select
a.pcp_region
, a.Month
, cast(coalesce((cast(a.adds as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4)) as [adds/mbr]				
, cast(coalesce((cast(a.conv_in as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [conv_in/mbr]		
, cast(coalesce((cast(a.terms as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [terms/mbr]         
, cast(coalesce((cast(a.conv_out as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [conv_out/mbr]    
, cast(coalesce((cast(a.plan_adds_conv_in as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [plan_conv_in/mbr] -- added
, cast(coalesce((cast(a.plan_terms_conv_out as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [plan_conv_out/mbr] -- added
from add_term_step1 a
)
, add_term_step3 as (
select
a.pcp_region
, a.Month
, case -- added case statements to retain as much real as possible and replace with ent defaults where out of thresholds
	when a.[adds/mbr] < b.Adds_Min then b.Adds_Min 
	when a.[adds/mbr] > b.Adds_Max then b.Adds_Max else a.[adds/mbr] end as [adds/mbr]
, case 
	when a.[conv_in/mbr] < b.Conv_in_Min then b.Conv_in_Min
	when a.[conv_in/mbr] > b.Conv_in_Max then b.Conv_in_Max else a.[conv_in/mbr] end as [conv_in/mbr]
, case 
	when a.[terms/mbr] < b.Terms_Min then b.Terms_Min
	when a.[terms/mbr] > b.Terms_Max then b.Terms_Max else a.[terms/mbr] end as [terms/mbr]
, case 
	when a.[conv_out/mbr] < b.Conv_out_Min then b.Conv_out_Min
	when a.[conv_out/mbr] > b.Conv_out_Max then b.Conv_out_Max else a.[conv_out/mbr] end as [conv_out/mbr]
, case when a.[plan_conv_in/mbr] > c.plan_conv_in_Max then c.plan_conv_in_Max else a.[plan_conv_in/mbr] end as [plan_conv_in/mbr]
, case when a.[plan_conv_out/mbr] > c.plan_conv_out_Max then c.plan_conv_out_Max else a.[plan_conv_out/mbr] end as [plan_conv_out/mbr]
from add_term_step2 a
	left join #add_terms_thresholds b on
		b.Month = a.month
	left join #plan_conv_thresholds c on
		c.Month = a.month
)
select
pcp_region
, Month
, [adds/mbr]
, [conv_in/mbr]
, [terms/mbr]
, [conv_out/mbr]
, [plan_conv_in/mbr]
, [plan_conv_out/mbr]
into #default_addsterms_rgn  
from add_term_step3;

