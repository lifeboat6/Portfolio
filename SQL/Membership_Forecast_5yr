	group by
		pcp_region
		, pcp_market
		, pcp_type
), jan_current as (
	select distinct
		pcp_region
		, pcp_market
		, pcp_type
		, sum(total_membership) as jan_mbrs
	from
		#output
	where
		yearmonth = Concat(((select * from #Year)), '01')
	group by
		pcp_region
		, pcp_market
		, pcp_type
)
