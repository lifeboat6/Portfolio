-- OEP SEP SETUP FOR USE TO MAKE %
drop table if exists #OEP_SEP;
WITH EligibilityCTE AS (
	SELECT
		CAST(LEFT(yearmonth, 4) AS INT) AS elig_year,
		pcp_region,
		pcp_market,
		pcp_type,
		plan_code,
		CASE
			WHEN right(yearmonth,2) = '12' and left(yearmonth,4) <> left(m.max_month,4) THEN CAST(LEFT(yearmonth, 4) AS INT) + 1
			ELSE null
		END AS join_year_lag,
		CAST(LEFT(yearmonth, 4) AS INT) AS join_year,
		total_membership,
		case when right(yearmonth,2) = '01' and left(yearmonth,4) <> left(mm.min_month,4) then 'jan'
			--when (yearmonth = (select max(yearmonth) from #output) or right(yearmonth,2) = '12') and left(yearmonth,4) <> left(mm.min_month,4)  then 'sep_end' 
			when (yearmonth = (select max(yearmonth) from #assumptions_base) or right(yearmonth,2) = '12') and left(yearmonth,4) <> left(mm.min_month,4)  then 'sep_end'
			else ''
			end as Join_type_sep,
		case when right(yearmonth,2) = '12' and left(yearmonth,4) <> left(m.max_month,4)  then 'py_end'
			else ''
			end as Join_type_py
	FROM #assumptions_base b
	left outer join (select max(yearmonth) as max_month from #assumptions_base) m on 1=1
	left outer join (select min(yearmonth) as min_month from #assumptions_base) mm on 1=1
	where right(yearmonth,2) = '12' or right(yearmonth,2) = '01' or yearmonth = m.max_month
	--and yearmonth between concat(((select * from #year) - 1), '01') and (select * from #ActualsCutoff)
)
SELECT
	b.*,
	ISNULL(pe.total_membership, 0) AS prior_year_end,   
	ISNULL(j.total_membership, 0) AS jan_mbrs,
	ISNULL(s.total_membership, 0) AS sep_end   
INTO #OEP_SEP
FROM
	(SELECT DISTINCT
		CAST(LEFT(yearmonth, 4) AS INT) AS elig_year,
		pcp_region,
		pcp_market,
		pcp_type,
		plan_code
	FROM #assumptions_base
	WHERE LEFT(yearmonth, 4) <> (SELECT LEFT(MIN(yearmonth), 4) FROM #output)
	--WHERE left(yearmonth, 4) = (select * from #Year) and yearmonth <= (select * from #ActualsCutoff)   --- bring in only current year to match excel process
	--WHERE left(yearmonth, 4) between (select min(yearmonth) from #assumption) and yearmonth <= (select * from #ActualsCutoff)
	) b
LEFT OUTER JOIN EligibilityCTE pe ON b.pcp_region = pe.pcp_region AND b.pcp_market = pe.pcp_market AND b.pcp_type = pe.pcp_type AND b.plan_code = pe.plan_code AND b.elig_year = pe.join_year_lag and pe.Join_type_py = 'py_end'
LEFT OUTER JOIN EligibilityCTE j ON b.pcp_region = j.pcp_region AND b.pcp_market = j.pcp_market AND b.pcp_type = j.pcp_type AND b.plan_code = j.plan_code AND b.elig_year = j.join_year and j.Join_type_sep = 'jan'
LEFT OUTER JOIN EligibilityCTE s ON b.pcp_region = s.pcp_region AND b.pcp_market = s.pcp_market AND b.pcp_type = s.pcp_type AND b.plan_code = s.plan_code AND b.elig_year = s.join_year and s.Join_type_sep = 'sep_end';

-- MKT Defaults OEP/SEP %
drop table if exists #mkt_OEP_SEP_Defaults;
with oep_sep_grouped as (
	select
	pcp_region
	, pcp_market
	, pcp_type
	, sum(prior_year_end) as prior_year_end
	, sum(jan_mbrs) as jan_mbrs
	, sum(sep_end) as sep_end
	from
	#OEP_SEP
	group by
	pcp_region
	, pcp_market
	, pcp_type
)
, oep_sep_growth as (
	select
	a.pcp_region
	, a.pcp_market
	, a.pcp_type
	, case when a.prior_year_end = 0 and a.jan_mbrs <> 0 then 1
		when a.prior_year_end = 0 and a.jan_mbrs = 0 then 0
		else (cast(a.jan_mbrs as decimal) - cast(a.prior_year_end as decimal)) / nullif(cast(a.prior_year_end as decimal), 0)
		end as OEP_Growth
	, case when a.jan_mbrs = 0 then 0
		else (cast(a.sep_end as decimal) - cast(a.jan_mbrs as decimal)) / nullif(cast(a.jan_mbrs as decimal), 0)
		end as SEP_Growth
	, 1 as join_key
	from oep_sep_grouped a
		inner join #mkt_over_50 b on
			b.pcp_region = a.pcp_region
			and b.pcp_market = a.pcp_market
			and b.pcp_type = a.pcp_type
)
select
a.pcp_region
, a.pcp_market
, a.pcp_type
, case 
	when a.OEP_Growth < 0 then 
		case 
			when a.OEP_Growth > b.OEP_Min then Cast(a.OEP_Growth as decimal(19,4))
			else Cast(b.OEP_Min as decimal(19,4))
		end
	else
		case 
			when a.OEP_Growth < b.OEP_Max then cast(a.OEP_Growth as decimal(19,4))
			else cast(b.OEP_Max as decimal(19,4))
		end
	end as OEP_Growth_Final
, case 
	when a.SEP_Growth < 0 then 
		case 
			when a.SEP_Growth > b.SEP_Min then cast(a.SEP_Growth as decimal(19,4))
			else cast(b.SEP_Min as decimal(19,4))
		end
	else
		case 
			when a.SEP_Growth < b.SEP_Max then cast(a.SEP_Growth as decimal(19,4))
			else cast(b.SEP_Max as decimal(19,4))
		end
	end as SEP_Growth_Final
into #mkt_OEP_SEP_Defaults
from
oep_sep_growth a
	left join #growthThresholds b on
		b.join_key = a.join_key;

