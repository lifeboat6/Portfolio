/*------------------------  ADDS TERMS CONV CALCS ----------------------------*/       
BEGIN

drop table if exists #outputFctMEM, #outputFctADD_TERM, #outputFctCONV_OUTprep, #outputFINALbase;

select a.*
,CAST(ROUND(fcst_membership, 0) AS INT) - lag(CAST(ROUND(fcst_membership, 0) AS INT),1,0) over(partition by grouper_id order by grouper_id,grouper_seq) as [Forecasted Net]                                                                       
into #outputFctMEM 
from
#temp1 a
order by grouper_id, grouper_seq
drop table #temp1;

select  a.*
,case when [Yearmonth]<= cast((select * from #ActualsCutoff) as int) then [adds] else CAST(ROUND(cast([fcst_Membership] as float)*[Adds/Mbr Assumption],0) AS INT) end as [Forecasted Adds]
,case when [Yearmonth]<= cast((select * from #ActualsCutoff) as int) then [terms] else CAST(ROUND(cast([fcst_Membership] as float)*[Terms/Mbr Assumption],0) AS INT) end as [Forecasted Terms]
,case when [Yearmonth]<= cast((select * from #ActualsCutoff) as int) then [conv_in] else CAST(ROUND(cast([fcst_Membership] as float)*[ConvIn/Mbr Assumption],0) AS INT) end as [Forecasted Conv In Prep]
,case when [Yearmonth]<= cast((select * from #ActualsCutoff) as int) then [plan_adds_conv_in] else CAST(ROUND(cast([fcst_Membership] as float)*[plan_convIn/Mbr],0) AS INT) end as [Forecasted Plan_Conv_In]
,case when [Yearmonth]<= cast((select * from #ActualsCutoff) as int) then [plan_terms_conv_out] else CAST(ROUND(cast([fcst_Membership] as float)*[plan_convOut/Mbr],0) AS INT) end as [Forecasted Plan_Conv_Out]
into #outputFctADD_TERM     --- drop table #outputFctADD_TERM  select * from #outputFctADD_TERM 
from
#outputFctMEM a
drop table #outputFctMEM;

select  a.*,
case when [Yearmonth]<= (select * from #ActualsCutoff) then [conv_out] else [Forecasted Adds]+[Forecasted Conv In Prep]-[Forecasted Net]-[Forecasted Terms] end as [Forecasted Conv Out Prep]
into #outputFctCONV_OUTprep     --- drop table #outputFctCONV_OUTprep   select * from #outputFctCONV_OUTprep 
from
#outputFctADD_TERM a
drop table #outputFctADD_TERM;

select  a.*,
case when [Forecasted Conv Out Prep]<0 then [Forecasted Conv In Prep]-[Forecasted Conv Out Prep] else [Forecasted Conv In Prep] end as [Forecasted Conv In],
case when [Forecasted Conv Out Prep]<0 then 0 else [Forecasted Conv Out Prep] end as [Forecasted Conv Out]
into #outputFINALbase     --- drop table #outputFINALbase   select * from #outputFINALbase 
from
#outputFctCONV_OUTprep a
order by grouper_id,grouper_seq
drop table #outputFctCONV_OUTprep;

END;

