-- ADDS TERMS DEFAULT % AT PLAN LEVEL
drop table if exists #default_addsterms_plan;

with 
add_term_step1 as (  -- aggregate data
select
a.pcp_region
, a.pcp_market
, a.pcp_type
, a.plan_type
, a.plan_code
, right(a.yearmonth, 2) as Month
, sum(a.adds) as adds
, sum(a.conv_in) as conv_in
, sum(a.terms) as terms
, sum(a.conv_out) as conv_out
, sum(a.total_net) as total_net
, sum(a.total_membership) as total_membership
, sum(a.plan_adds_conv_in) as plan_adds_conv_in
, sum(a.plan_terms_conv_out) as plan_terms_conv_out
from #assumptions_base_addsterms a
group by
a.pcp_region
, a.pcp_market
, a.pcp_type
, a.plan_type
, a.plan_code
, right(a.yearmonth, 2)
)
, add_term_step2 as (  -- calculate %s using aggregate data and add flags for new and < 50 plans
select
a.pcp_region
, a.pcp_market
, a.pcp_type
, a.plan_type
, a.plan_code
, a.Month
, a.total_membership
, cast(coalesce((cast(a.adds as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4)) as [adds/mbr]				--- keep with backing out net?
, cast(coalesce((cast(a.conv_in as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [conv_in/mbr]		--- keep with backing out net?
, cast(coalesce((cast(a.terms as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [terms/mbr]          --- keep with backing out net?
, cast(coalesce((cast(a.conv_out as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [conv_out/mbr]    --- keep with backing out net?
, cast(coalesce((cast(a.plan_adds_conv_in as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [plan_conv_in/mbr] -- added
, cast(coalesce((cast(a.plan_terms_conv_out as decimal)/nullif(a.total_membership - a.total_net,0)),0) as decimal(19,4))  as [plan_conv_out/mbr] -- added
, case when b.plan_code is null then 1 else 0 end as plan_under_50
, case when d.plan_code is not null then 1 else 0 end as new_plan
from add_term_step1 a
	left join #plan_over_50 b on
		b.pcp_region = a.pcp_region
		and b.pcp_market = a.pcp_market
		and b.pcp_type = a.pcp_type
		and b.plan_code = a.plan_code
	left join #new_plans d on
		d.pcp_region = a.pcp_region
		and d.pcp_market = a.pcp_market
		and d.pcp_type = a.pcp_type
		and d.plan_code = a.plan_code
)
,add_term_step3 as (  -- create table with default and error handling logic 
select
a.pcp_region
, a.pcp_market
, a.pcp_type
, a.plan_type
, a.plan_code
, a.Month
, a.total_membership
, case 
	when a.[adds/mbr] < 0 then 0
	when a.[adds/mbr] is null then isnull(c.[adds/mbr],d.[adds/mbr])
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[adds/mbr],d.[adds/mbr])
	when a.[adds/mbr] > c.[adds/mbr] then c.[adds/mbr] else a.[adds/mbr] end as [adds/mbr]
, case 
	when a.[conv_in/mbr] < 0 then 0
	when a.[conv_in/mbr] is null then isnull(c.[conv_in/mbr], d.[conv_in/mbr])
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[conv_in/mbr],d.[conv_in/mbr])
	when a.[conv_in/mbr] > c.[conv_in/mbr] then c.[conv_in/mbr] else a.[conv_in/mbr] end as [conv_in/mbr]
, case 
	when a.[terms/mbr] < 0 then 0
	when a.[terms/mbr] is null then isnull(c.[terms/mbr], d.[terms/mbr])
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[terms/mbr], d.[terms/mbr])
	when a.[terms/mbr] > c.[terms/mbr] then c.[terms/mbr] else a.[terms/mbr] end as [terms/mbr]
, case 
	when a.[conv_out/mbr] < 0 then 0
	when a.[conv_out/mbr] is null then isnull(c.[conv_out/mbr], d.[conv_out/mbr])
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[conv_out/mbr], d.[conv_out/mbr])
	when a.[conv_out/mbr] > c.[conv_out/mbr] then c.[conv_out/mbr] else a.[conv_out/mbr] end as [conv_out/mbr]
, case
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[plan_conv_in/mbr], d.[plan_conv_in/mbr])
	when a.[plan_conv_in/mbr] > c.[plan_conv_in/mbr] then c.[plan_conv_in/mbr]
	when a.[plan_conv_in/mbr] is null then isnull(c.[plan_conv_in/mbr], d.[plan_conv_in/mbr]) else a.[plan_conv_in/mbr] end as [plan_conv_in/mbr]
, case 
	when a.new_plan = '1'  or a.plan_under_50 = '1' then isnull(c.[plan_conv_out/mbr], d.[plan_conv_out/mbr])
	when a.[plan_conv_out/mbr] > c.[plan_conv_out/mbr] then c.[plan_conv_out/mbr]
	when a.[plan_conv_out/mbr] is null then isnull(c.[plan_conv_out/mbr], d.[plan_conv_out/mbr]) else a.[plan_conv_out/mbr] end as [plan_conv_out/mbr]
, plan_under_50
, new_plan
, case when a.[adds/mbr] < b.Adds_Min or a.[adds/mbr] > b.Adds_Max then 1 else 0 end as adds_flag
, case when a.[conv_in/mbr] < b.Conv_in_Min or a.[conv_in/mbr] > b.Conv_in_Max then 1 else 0 end as conv_in_flag
, case when a.[terms/mbr] < b.Terms_Min or a.[terms/mbr] > b.Terms_Max then 1 else 0 end as term_flag
, case when a.[conv_out/mbr] < b.Conv_out_Min or a.[conv_out/mbr] > b.Conv_out_Max then 1 else 0 end as conv_out_flag
from add_term_step2 a
	left join #add_terms_thresholds b on
		b.Month = a.month
	left join #default_addsterms_mkt c on
		c.pcp_market = a.pcp_market
		and c.pcp_type = a.pcp_type
		and c.plan_type = a.plan_type
		and c.Month = a.Month
	left join #default_addsterms_rgn d on -- select * from #default_addsterms_rgn_mkt where pcp_market = 'NFL' order by 1,2,3 
		d.pcp_region = a.pcp_region
		and d.Month = a.Month
)
select
pcp_region
, pcp_market
, pcp_type
, plan_code
, Month
, total_membership
, [adds/mbr]
, [conv_in/mbr]
, [terms/mbr]
, [conv_out/mbr]
, [plan_conv_in/mbr]
, [plan_conv_out/mbr]
into #default_addsterms_plan  
from add_term_step3;

