/* FORECAST MEMBERSHIP SECTION 2 : REC CTE 1 FORECAST CURRENT YEAR; LOOPED REC CTE 2 FORECAST OUTER YEARS (+5) */

-- select * into #temp1backup from #temp1; --  |	drop table #temp1	|	select * into #temp1 from #temp1backup	select count(*) from #temp1
	
-- Final Indexing for optimization  
CREATE NONCLUSTERED INDEX idx_temp1_forecast ON #temp1 (grouper_id, grouper_seq);
go

ALTER TABLE #temp1 ADD yearmonth_date DATE;
go

UPDATE #temp1
SET yearmonth_date = DATEFROMPARTS(LEFT(yearmonth, 4), RIGHT(yearmonth, 2), 1);

DECLARE @ActualsCutoff VARCHAR(6) = (SELECT TOP 1 ActualsCutoff FROM #ActualsCutoff);
DECLARE @cutoffYear VARCHAR(4) = LEFT(@ActualsCutoff, 4);
DECLARE @cutoffMonth VARCHAR(2) = RIGHT('0' + @ActualsCutoff, 2);

-- Recursive CTE to calculate forecast_membership
WITH ForecastCTE AS (
    SELECT 
        grouper_id,
        yearmonth,
		yearmonth_date,
        total_membership AS forecast_membership
    FROM #temp1
    WHERE yearmonth = @ActualsCutoff

    UNION ALL

    SELECT 
        t.grouper_id,
        t.yearmonth,
		t.yearmonth_date,
        case 
			when right(t.yearmonth, 2) = '01' and r.forecast_membership is not null
				then CAST(r.forecast_membership * (1 + t.oep) AS FLOAT) 
			when right(t.yearmonth, 2) > '01' and left(t.yearmonth, 4) = @cutoffYear and r.forecast_membership is not null
				then CAST(r.forecast_membership + t.mnthly_member AS FLOAT)
			end AS forecast_membership
    FROM #temp1 t
    INNER JOIN ForecastCTE r
        ON t.grouper_id = r.grouper_id
		AND t.yearmonth_date = DATEADD(MONTH, 1, r.yearmonth_date)
    WHERE t.yearmonth between @ActualsCutoff and (cast(@cutoffYear + 1 as varchar) + '01')
)

UPDATE t
SET t.fcst_membership =  f.forecast_membership
FROM #temp1 t
INNER JOIN ForecastCTE f
    ON t.grouper_id = f.grouper_id AND t.yearmonth = f.yearmonth;
GO  

