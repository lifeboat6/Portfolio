----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
--//  Forecast future years  //--

-- Begin Loop
DECLARE @ActualsCutoff VARCHAR(6) = (SELECT TOP 1 ActualsCutoff FROM #ActualsCutoff);
DECLARE @cutoffYear VARCHAR(4) = LEFT(@ActualsCutoff, 4);
DECLARE @cutoffMonth VARCHAR(2) = RIGHT('0' + @ActualsCutoff, 2);
DECLARE @lastloop_n INT = 0;
DECLARE @loop_n INT = 1;


WHILE @loop_n <= 5   --- setting this for 5 yr forecast i.e. loop through 5 times

BEGIN

--calc next year monthly growth
with currentYrCalc as (
			select *
			, case when @loop_n >= 2 and SEP < .01 then ISNULL(((fcst_membership * 0.015)/cast(11 as float)),0) else ISNULL(((fcst_membership * SEP)/cast(11 as float)),0) end as mnthly_member2  
			from #temp1 y
			where yearmonth = (cast(@cutoffYear + @loop_n as varchar) + '01')     
								)
		UPDATE #temp1
		SET mnthly_member =  a.mnthly_member2
		from currentYrCalc a 
			INNER JOIN #temp1 x
				on a.plan_code = x.plan_code
				and left(a.yearmonth, 4) = left(x.yearmonth, 4)
				and a.pcp_region = x.pcp_region
				and a.pcp_market = x.pcp_market
				and a.pcp_pool = x.pcp_pool
				and a.pcp_type = x.pcp_type;

-- Recursive CTE to calculate [TESTING] for next year
WITH ForecastCTE AS (
    SELECT 
        grouper_id,
        yearmonth,
		yearmonth_date,
		cast(fcst_membership as float) as forecast_membership
    FROM #temp1
    WHERE yearmonth = (cast(@cutoffYear + @loop_n as varchar) + '01')

    UNION ALL

    SELECT 
        t.grouper_id,
        t.yearmonth,
		t.yearmonth_date,
        case 
			when right(t.yearmonth, 2) > '01' and left(t.yearmonth, 4) = (cast(@cutoffYear + @loop_n as varchar)) and r.forecast_membership is not null
				then CAST(r.forecast_membership + t.mnthly_member AS FLOAT)
			when right(t.yearmonth, 2) = '01' and left(t.yearmonth, 4) = (cast(@cutoffYear + @loop_n + 1 as varchar)) and r.forecast_membership is not null
				then CAST(r.forecast_membership * (1 + t.oep) AS FLOAT) 
			end AS forecast_membership
    FROM #temp1 t
    INNER JOIN ForecastCTE r
        ON t.grouper_id = r.grouper_id
		AND t.yearmonth_date = DATEADD(MONTH, 1, r.yearmonth_date)
    WHERE t.yearmonth between (cast(@cutoffYear + @loop_n as varchar) + '02') and (cast(@cutoffYear + @loop_n + 1 as varchar) + '01')
)

UPDATE t
SET t.fcst_membership =  f.forecast_membership
FROM #temp1 t
INNER JOIN ForecastCTE f
    ON t.grouper_id = f.grouper_id AND t.yearmonth = f.yearmonth;

SET @lastloop_n = @loop_n;
SET @loop_n = @lastloop_n + 1;

END;
go

---------------------------------------------------------------------------------------------------------------------------------
/*------------------------ Seasonality to Fcst_Memberhsip --------------------------*/
--  NOTE: need to add this prior to all other calcs because alot work ofF this number 
--  Formula below will be first finding month over month growth %s in 1st cte, then apply that percent to sep%
--  Final Formula = fcst_Memberhsip * (1 + (month_over_month_diff [%] * SEP%))

DROP TABLE IF EXISTS #SEP_Seasonality;

SELECT
pcp_market
, plan_type
, Bmonth
, SUM(total_membership) AS monthly_sum
, SUM(NULLIF(total_membership,0)) / LAG(SUM(NULLIF(total_membership,0))) OVER (
	PARTITION BY pcp_market, plan_type 
	ORDER BY Bmonth
	) - 1 AS month_over_month_diff
INTO #SEP_Seasonality
FROM #temp1
WHERE Byear = (SELECT * FROM #Year) - 1 AND Bmonth BETWEEN 1 AND 11 -- pull prior year
GROUP BY
pcp_market
, plan_type
, Bmonth;

GO

-- Apply monthly Seasonality (15 sec)
UPDATE t 
SET
--SELECT t.*,
t.fcst_membership = CASE WHEN t.yearmonth BETWEEN (SELECT * FROM #ActualsCutoff) + 1 AND CONCAT((SELECT * FROM #Year), '11')  THEN (CAST(t.fcst_membership AS FLOAT) * ( 1 + (ISNULL(s.month_over_month_diff,0) * t.SEP)))--(CAST(t.fcst_membership AS FLOAT) * ( 1 + ISNULL(c.s_factor,0)))
					WHEN t.Byear > (SELECT * FROM #Year) AND t.Bmonth = '01' THEN t.fcst_membership
					WHEN t.Byear > (SELECT * FROM #Year) AND t.Bmonth BETWEEN '02' AND '11' THEN (CAST(t.fcst_membership AS FLOAT) * ( 1 + (ISNULL(s.month_over_month_diff,0) * t.SEP))) --(t.fcst_membership * ( 1 + ISNULL(s.s_factor,0)))
					ELSE t.fcst_membership END --AS seasoned_mbrs
FROM #temp1 t
	LEFT JOIN #SEP_Seasonality s ON 
		s.pcp_market = t.pcp_market
		AND s.plan_type = t.plan_type
		AND s.Bmonth = t.Bmonth;

GO

