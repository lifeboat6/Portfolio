/*---------------------------------------------------- APPLY ACTUALS DETAIL UPDATES --------------------------------------------------------*/
-- various updates: region/market, proper case pcp_types, lead and lag months, etc
Update x
 set x.pcp_type = UPPER(LEFT(x.pcp_type, 1)) + LOWER(RIGHT(x.pcp_type, LEN(x.pcp_type) - 1)) 
 , x.lag_month = left(convert(varchar, DATEADD(month, -1, cast(left(x.elig_month,4)+'-'+right(x.elig_month,2)+'-01'as date)), 112), 6) 
 , x.lead_month = left(convert(varchar, DATEADD(month, 1, cast(left(x.elig_month,4)+'-'+right(x.elig_month,2)+'-01'as date)), 112), 6) 
 , x.market = case when x.m = 'L' then x.market + '_L'
					when x.PCP_Clinic_Code = 'UNID' then 'NG' else x.market end
 , x.region = case when x.m = 'L' then x.region + '_L'
					when x.PCP_Clinic_Code = 'UNID' then 'X' else x.region end
 , x.PCP_Clinic_Code = case when x.PCP_Clinic_Code = 'UNIDUNID' then 'UNID' else x.PCP_Clinic_Code end
 , x.IKA_Clinic_Code = case when x.IKA_Clinic_Code = 'UNIDUNID' then 'UNID' else x.IKA_Clinic_Code end
 , x.practice = case when x.pcp_type = 'AFFILIATED' then 'AFF'
					when x.pcp_type = 'CONTRACTED' then 'CON'
					else x.practice end
 , segment = case when x.m = 'L' then '00007' else segment end
 , ess_unit = case when x.m = 'L' then '70000' else ness_unit end
 , x.department = case when PCP_Clinic_Code = 'UNID' and region = 'G' and department is null then '60000' else x.department end
 , x.[location] = case when PCP_Clinic_Code = 'UNID' and region = 'G' and department is null then 'US00000' else x.[location] end
from #elig x;

