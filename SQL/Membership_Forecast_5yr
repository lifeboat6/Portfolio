/* FORECAST MEMBERSHIP SECTION 1 : ESTABLISH GROUPERS AND INDEXING, FORECAST +1 MONTH, AND LOOP THROUGH REMAINING CURRENT YEAR */
BEGIN

DROP TABLE IF EXISTS #step_one, #temp1, #actuals_plusone, #grouper, #gpr;

-- Prepare small data set for testing
DECLARE @jumpoff INT = (select * from #ActualsCutoff);

SELECT *,
    NULL AS grouper_id,
    NULL AS grouper_seq
INTO #temp1
FROM #outputASMPT2
ORDER BY [Byear], [Bmonth];

drop table if exists #outputASMPT2;

--Create grouper indexes
WITH grouper AS (
    SELECT DISTINCT
        plan_code,
        pcp_market,
        pcp_pool,
        pcp_type
    FROM #temp1
)
SELECT * INTO #grouper FROM grouper;

WITH gpr AS (
    SELECT
        *,
        ROW_NUMBER() OVER (ORDER BY (SELECT 0)) AS grouper_id
    FROM #grouper
)
SELECT * INTO #gpr FROM gpr;

-- Create indexes on #grouper and #gpr
CREATE INDEX idx_grouper ON #grouper (plan_code, pcp_market, pcp_pool, pcp_type);
CREATE INDEX idx_gpr ON #gpr (grouper_id);

-- Update #temp1 with grouper_id and grouper_seq
WITH x AS (
    SELECT
        x.Lookup_ID_yrmonth,
        g.grouper_id,
        ROW_NUMBER() OVER (PARTITION BY g.grouper_id ORDER BY yearmonth ASC) AS grouper_seq
    FROM #temp1 x
    INNER JOIN #gpr g 
        ON g.plan_code = x.plan_code
        AND g.pcp_market = x.pcp_market
        AND g.pcp_pool = x.pcp_pool
        AND g.pcp_type = x.pcp_type
)
UPDATE t
SET t.grouper_id = x.grouper_id,
    t.grouper_seq = x.grouper_seq
FROM #temp1 t
INNER JOIN x 
    ON x.Lookup_ID_yrmonth = t.Lookup_ID_yrmonth;

-- Create indexes on #temp1
CREATE INDEX idx_temp1 ON #temp1 (grouper_id, grouper_seq);

-- Create clustered index on #temp1
CREATE CLUSTERED INDEX Indx1 ON #temp1 (grouper_seq, grouper_id);

-- Add forecast membership column
ALTER TABLE #temp1
ADD [fcst_membership] DECIMAL(18, 6) DEFAULT (0.0);

-- Create #actuals_plusone table
SELECT
    x.Lookup_ID_yrmonth,
    x.[Bmonth],
    x.grouper_seq,
    x.grouper_id,
	x.mnthly_member,
    CASE 
        WHEN x.yearmonth <= (select * from #ActualsCutoff) THEN CAST(x.total_membership AS FLOAT)
        WHEN CAST(x.yearmonth AS INT) = (CAST((select * from #ActualsCutoff) AS INT) + 1) THEN (
		ISNULL(LAG(CAST(x.total_membership AS FLOAT), 1, 0) OVER (PARTITION BY x.grouper_id ORDER BY x.grouper_id, x.grouper_seq),0) + x.mnthly_member
        )
        ELSE null
    END AS mbr
INTO #actuals_plusone      
FROM #temp1 x;       

-- Update forecast membership in #temp1
UPDATE x
SET x.fcst_membership = y.mbr
FROM #temp1 x
INNER JOIN #actuals_plusone y
    ON y.grouper_seq = x.grouper_seq AND y.grouper_id = x.grouper_id;

-- Drop #actuals_plusone table
DROP TABLE IF EXISTS #actuals_plusone;

-- update forecast membership in #temp1 with adjusted starting membership typically future year jan    
update x
set x.fcst_membership = y.adj_membership
from #temp1 x
	inner join #Adj2 y on
		y.plan_code = x.plan_code and y.pcp_market = x.pcp_market and y.pcp_pool = x.pcp_pool and y.pcp_type = x.pcp_type and y.yearmonth = (cast(x.Byear as varchar) + right('0' + cast(x.Bmonth as varchar), 2));

drop table #Adj2;

END;

